# Copy to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=cofur.in,www.cofur.in,127.0.0.1,localhost

# Database: mysql (default) or sqlite (local fallback only)
DATABASE_ENGINE=mysql
DATABASE_NAME=cofur
DATABASE_USER=cofur
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

CORS_ALLOWED_ORIGINS=https://cofur.in
CSRF_TRUSTED_ORIGINS=https://cofur.in,https://www.cofur.in

# Leave blank to use <project>/media and <project>/staticfiles
MEDIA_ROOT=
MEDIA_URL=/media/
STATIC_ROOT=
STATIC_URL=/static/
USE_MANIFEST_STATIC=False

# Security (production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SECURE_PROXY_SSL_HEADER=True

# Admin panel access
ADMIN_URL=admin/                    # change to something private, e.g. cofur-office-9f3a/
ADMIN_ALLOWED_IPS=                  # comma-separated IPs or CIDR ranges allowed to open the admin; empty = any
ADMIN_LOGIN_MAX_ATTEMPTS=5          # failed sign-ins before lockout (per IP and per username)
ADMIN_LOGIN_LOCKOUT_MINUTES=15
ADMIN_INACTIVITY_MINUTES=30         # auto sign-out after this much idle time

# Email for enquiry notifications (optional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@cofur.in
ENQUIRY_NOTIFICATION_EMAIL=info@cofur.in

# Uploads
MAX_VIDEO_UPLOAD_MB=100
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_DIMENSION=6000
IMAGE_MAX_EDGE=2400
IMAGE_CONVERT_WEBP=True
IMAGE_WEBP_QUALITY=82

TIME_ZONE=Asia/Kolkata
DASHBOARD_PAGE_SIZE=20
LOG_LEVEL=WARNING
